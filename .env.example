# =====================================================================
#  Teleticket - configuracion local
# =====================================================================
#
#  Copia este archivo a ".env" (que Git ignora) y ajusta lo que necesites:
#
#      Copy-Item .env.example .env
#
#  NO hace falta tocar nada si tu maquina tiene libres los puertos de abajo:
#  los valores por defecto de cada servicio son exactamente estos.
#
#  Quien lee este archivo:
#    - arrancar-todo.ps1 / detener-todo.ps1 / verificar-*.ps1  (lo cargan solos)
#    - docker compose, solo si lo pides:
#          cd infra ; docker compose --env-file ../.env up -d
#    - Eclipse / IntelliJ: NO lo leen. Define las variables en la
#      configuracion de ejecucion (pestana Environment) o usa los scripts.
#
#  Reglas del formato: una variable por linea, sin comillas, y los
#  comentarios en su propia linea (nunca al final de un valor).
#  Una variable ya definida en tu consola gana sobre este archivo.
# =====================================================================


# ---------------------------------------------------------------------
#  PostgreSQL  (la instancia de Docker, con las 9 bases)
# ---------------------------------------------------------------------
# Host donde estan las bases. Con los servicios fuera de Docker es localhost.
DB_HOST=localhost
# Puerto del lado de tu maquina. Es 5433 porque el 5432 suele estar ocupado
# por un PostgreSQL instalado en Windows; si el tuyo esta libre puedes usar 5432.
DB_PORT=5433
DB_USER=teleticket
DB_PASSWORD=teleticket
# DB_NAME no se define aqui a proposito: cada servicio tiene su propia base
# (db_eventos, db_cola, ...) y una sola variable las pisaria todas.
#
# Ojo: usuario y contrasena solo se aplican al CREAR el volumen de Postgres.
# Si los cambias despues: cd infra ; docker compose down -v   (borra los datos)


# ---------------------------------------------------------------------
#  RabbitMQ
# ---------------------------------------------------------------------
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
# Consola web: http://localhost:15672 (solo la usa docker compose)
RABBIT_CONSOLA_PORT=15672


# ---------------------------------------------------------------------
#  MailHog  (SMTP falso; solo lo usa docker compose por ahora)
# ---------------------------------------------------------------------
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025


# ---------------------------------------------------------------------
#  Puertos de los servicios
# ---------------------------------------------------------------------
# Si cambias uno, las URLs entre servicios (MS_*_URL) lo siguen solas.
# El gateway usa 8090 y no 8080 porque el 8080 estaba ocupado en la
# maquina original; si el 8090 te estorba, cambialo aqui.
GATEWAY_PORT=8090
MS_USUARIOS_PORT=8081
MS_EVENTOS_PORT=8082
MS_COLA_PORT=8083
MS_INVENTARIO_PORT=8084
MS_ORDENES_PORT=8085
MS_PAGOS_PORT=8086
MS_TICKETS_PORT=8087
MS_NOTIFICACIONES_PORT=8088


# ---------------------------------------------------------------------
#  URLs entre servicios  (opcionales)
# ---------------------------------------------------------------------
# Por defecto valen http://localhost:<puerto del destino>. Solo se definen
# cuando el servicio destino vive en otro host o en un contenedor (fase 15):
#
# MS_USUARIOS_URL=http://localhost:8081
# MS_EVENTOS_URL=http://localhost:8082
# MS_COLA_URL=http://localhost:8083
# MS_INVENTARIO_URL=http://localhost:8084
# MS_ORDENES_URL=http://localhost:8085
# MS_PAGOS_URL=http://localhost:8086
# MS_TICKETS_URL=http://localhost:8087


# ---------------------------------------------------------------------
#  Seguridad
# ---------------------------------------------------------------------
# Clave del HMAC con que ms-tickets firma las entradas. Minimo 32 caracteres:
# con menos, el servicio no arranca. Quien la conozca puede fabricar entradas
# validas, asi que en un despliegue real usa una propia y no la subas a Git.
TICKETS_CLAVE_FIRMA=clave-de-desarrollo-teleticket-no-usar-en-produccion

# Origenes que el navegador puede usar para llamar al gateway (separados por coma).
CORS_ORIGENES=http://localhost:3000,http://localhost:5173,http://localhost:4200


# ---------------------------------------------------------------------
#  Ajustes de demo  (comentados: los valores por defecto son los normales)
# ---------------------------------------------------------------------
# Siembra los 6 usuarios de prueba si la tabla esta vacia. En un entorno real: false.
# SEMBRAR_USUARIOS=true

# Sala de espera (ms-cola): para ver el sorteo sin esperar.
# COLA_CAPACIDAD_POR_CICLO=20
# COLA_CICLO_SEGUNDOS=10
# COLA_PASE_MINUTOS=10

# Demo de la saga de reembolso (ms-tickets): la emision falla a proposito.
# TICKETS_SIMULAR_FALLO=false
